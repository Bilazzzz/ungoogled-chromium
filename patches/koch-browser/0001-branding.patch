From: Koch Browser Developers <koch-browser@example.com>
Subject: [PATCH] Add Koch Browser branding

Replace Chromium branding with Koch Browser branding throughout the UI
---
diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index 1234567..abcdefg 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -12,7 +12,7 @@
         <if expr="not branding_path_component">
           <!-- The brand name to display in various dialog boxes and messages -->
-          <part id="IDS_PRODUCT_NAME" value="ungoogled-chromium"/>
+          <part id="IDS_PRODUCT_NAME" value="Koch Browser"/>
         </if>
         <if expr="branding_path_component">
           <part id="IDS_PRODUCT_NAME" value="%IDS_PRODUCT_NAME%"/>
@@ -24,7 +24,7 @@
         <if expr="not branding_path_component">
           <!-- The product name to display in about:version and internal crash handling -->
-          <part id="IDS_SHORT_PRODUCT_NAME" value="ungoogled-chromium"/>
+          <part id="IDS_SHORT_PRODUCT_NAME" value="Koch Browser"/>
         </if>
         <if expr="branding_path_component">
           <part id="IDS_SHORT_PRODUCT_NAME" value="%IDS_SHORT_PRODUCT_NAME%"/>
@@ -36,7 +36,7 @@
         <if expr="not branding_path_component">
           <!-- The brand name to use in accessibility strings -->
-          <part id="IDS_APP_NAME" value="ungoogled-chromium"/>
+          <part id="IDS_APP_NAME" value="Koch Browser"/>
         </if>
         <if expr="branding_path_component">
           <part id="IDS_APP_NAME" value="%IDS_APP_NAME%"/>
diff --git a/chrome/app/generated_resources.grd b/chrome/app/generated_resources.grd
index 2345678..bcdefgh 100644
--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -145,7 +145,7 @@
       <message name="IDS_BOOKMARK_BAR_APP_NAME" desc="The name of the application used in the bookmark bar">
-        Chromium
+        Koch Browser
       </message>
       <message name="IDS_SETTINGS_PAGE_TITLE" desc="The title of the settings page">
-        Settings - Chromium
+        Settings - Koch Browser
       </message>
diff --git a/chrome/browser/about_flags.cc b/chrome/browser/about_flags.cc
index 3456789..cdefghi 100644
--- a/chrome/browser/about_flags.cc
+++ b/chrome/browser/about_flags.cc
@@ -1234,7 +1234,7 @@
     {"product-name", IDS_PRODUCT_NAME},
-    {"ungoogled-chromium", "ungoogled-chromium"},
+    {"koch-browser", "Koch Browser"},
   };
diff --git a/ui/base/l10n/l10n_util.cc b/ui/base/l10n/l10n_util.cc
index 4567890..defghij 100644
--- a/ui/base/l10n/l10n_util.cc
+++ b/ui/base/l10n/l10n_util.cc
@@ -89,7 +89,7 @@
 const char16_t kProduct[] = u"Chromium";
+const char16_t kProduct[] = u"Koch Browser";
