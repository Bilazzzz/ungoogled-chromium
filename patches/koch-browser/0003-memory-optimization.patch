+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kRendererPriorityBoost)) {
+    host_->SetProcessPriority(
+        base::kLowestProcessPriority);
+  }
+
   // Create the renderer process with appropriate sandbox type
   std::unique_ptr<ServiceManager> service_manager;
   if (!InSameSecurityContextAsParent()) {
diff --git a/content/browser/memory_pressure_monitor.cc b/content/browser/memory_pressure_monitor.cc
index kkk1111...lll2222 100644
--- a/content/browser/memory_pressure_monitor.cc
+++ b/content/browser/memory_pressure_monitor.cc
@@ -85,6 +85,11 @@ void MemoryPressureMonitor::OnMemoryPressure(
   switch (level) {
     case base::MemoryPressureListener::MEMORY_PRESSURE_LEVEL_MODERATE:
       HandleModeratePressure();
+      // Koch Browser: Trigger earlier discarding
+      if (delegate_) {
+        delegate_->ReclaimMemory(
+            base::MemoryPressureListener::MEMORY_PRESSURE_LEVEL_CRITICAL);
+      }
       break;
     case base::MemoryPressureListener::MEMORY_PRESSURE_LEVEL_CRITICAL:
       HandleCriticalPressure();
diff --git a/chrome/browser/ui/tabs/tab_strip_model.cc b/chrome/browser/ui/tabs/tab_strip_model.cc
index mmm3333...nnn4444 100644
--- a/chrome/browser/ui/tabs/tab_strip_model.cc
+++ b/chrome/browser/ui/tabs/tab_strip_model.cc
@@ -1200,6 +1200,13 @@ void TabStripModel::DiscardTabAt(int index, DiscardReason reason) {
   if (!CanCloseTabAt(index))
     return;
 
+  // Koch Browser: Never discard active tab
+  if (active_index_ == index && count() > 1) {
+    DVLOG(1) << "Skipping discard of active tab";
+    return;
+  }
+
+  // Skip recently used tabs
   auto* contents = GetWebContentsAt(index);
   if (contents && !ShouldDiscardWebContents(contents, reason)) {
     return;
