From: Koch Browser Developers <koch-browser@example.com>
Subject: [PATCH] Integrate KOCH BRAUZER New Tab Page

Embed KOCH BRAUZER extension directly into Chromium source code
and set it as the default new tab page.
---
diff --git a/chrome/browser/ui/webui/BUILD.gn b/chrome/browser/ui/webui/BUILD.gn
index 3333333..4444444 100644
--- a/chrome/browser/ui/webui/BUILD.gn
+++ b/chrome/browser/ui/webui/BUILD.gn
@@ -50,6 +50,7 @@ group("webui") {
     "ntp_tiles",
     "omnibox",
     "settings",
+    "koch_new_tab_page",
     "sync_promo",
   ]
 }
diff --git a/chrome/browser/resources/koch_new_tab_page/koch_new_tab_page.grd b/chrome/browser/resources/koch_new_tab_page/koch_new_tab_page.grd
new file mode 100644
index 0000000..6666666
--- /dev/null
+++ b/chrome/browser/resources/koch_new_tab_page/koch_new_tab_page.grd
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<grit latest_public_release="0" current_release="1" output_all_resource_defines="false">
+  <outputs>
+    <output filename="grit/chrome_browser_koch_new_tab_page_header.h" type="rc_header" context="default" />
+    <output filename="grit/chrome_browser_koch_new_tab_page_map.cc" type="resource_file_map" context="default" />
+  </outputs>
+  <structures>
+    <structure name="IDR_KOCH_NEW_TAB_PAGE_HTML" filepath="koch_new_tab_page.html" type="chrome_html" />
+    <structure name="IDR_KOCH_NEW_TAB_PAGE_CSS" filepath="koch_new_tab_page.css" type="chrome_css" />
+    <structure name="IDR_KOCH_NEW_TAB_PAGE_JS" filepath="koch_new_tab_page.js" type="chrome_js" />
+  </structures>
+</grit>
diff --git a/chrome/browser/ui/webui/koch_new_tab_page/BUILD.gn b/chrome/browser/ui/webui/koch_new_tab_page/BUILD.gn
new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/chrome/browser/ui/webui/koch_new_tab_page/BUILD.gn
@@ -0,0 +1,44 @@
+# Copyright 2024 Koch Browser Developers. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/resources/build_flags.gni")
+import("//ui/webui_resources.gni")
+
+chrome_pak_inputs("koch_new_tab_page_pak_files") {
+  sources = [
+    "koch_new_tab_page.html",
+    "koch_new_tab_page.css",
+    "koch_new_tab_page.js",
+  ]
+  path_prefix = "chrome/browser/resources/koch_new_tab_page"
+  output_path = "$root_gen_dir/chrome/browser_koch_new_tab_page.grd.pak"
+}
+
+grit("koch_new_tab_page_grd") {
+  source = "koch_new_tab_page.grd"
+  outputs = [
+    "grit/chrome_browser_koch_new_tab_page_header.h",
+    "grit/chrome_browser_koch_new_tab_page_map.cc",
+  ]
+  defines = chrome_grit_defines()
+  deps = [
+    ":koch_new_tab_page_pak_files",
+  ]
+}
+
+source_set("koch_new_tab_page") {
+  sources = [
+    "koch_new_tab_page_handler.cc",
+    "koch_new_tab_page_handler.h",
+    "koch_new_tab_page_ui.cc",
+    "koch_new_tab_page_ui.h",
+  ]
+
+  deps = [
+    ":koch_new_tab_page_grd",
+    "//base",
+    "//chrome/browser:browser",
+    "//chrome/common",
+    "//components/prefs",
+    "//content/public/browser",
+    "//ui/webui",
+  ]
+}
diff --git a/chrome/browser/ui/webui/koch_new_tab_page/koch_new_tab_page_ui.cc b/chrome/browser/ui/webui/koch_new_tab_page/koch_new_tab_page_ui.cc
new file mode 100644
index 0000000..8888888
--- /dev/null
+++ b/chrome/browser/ui/webui/koch_new_tab_page/koch_new_tab_page_ui.cc
@@ -0,0 +1,67 @@
+// Copyright 2024 Koch Browser Developers. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/koch_new_tab_page/koch_new_tab_page_ui.h"
+
+#include "chrome/browser/ui/webui/koch_new_tab_page/koch_new_tab_page_handler.h"
+#include "chrome/grit/chrome_browser_koch_new_tab_page_header.h"
+#include "components/grit/components_scaled_resources.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/browser/web_ui_message_handler.h"
+#include "net/base/data_url.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace {
+
+constexpr char kChromeUIKochNewTabHost[] = "koch-new-tab-page";
+
+}  // namespace
+
+KochNewTabPageUI::KochNewTabPageUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::Create(kChromeUIKochNewTabHost);
+
+  source->SetDefaultResource(IDR_KOCH_NEW_TAB_PAGE_HTML);
+  source->AddResourcePath("koch_new_tab_page.css", IDR_KOCH_NEW_TAB_PAGE_CSS);
+  source->AddResourcePath("koch_new_tab_page.js", IDR_KOCH_NEW_TAB_PAGE_JS);
+
+  source->SetContentSecurityPolicy(
+      "script-src 'self' 'unsafe-inline' https://fonts.cdnfonts.com; "
+      "object-src 'self'; "
+      "connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com;");
+
+  content::WebUIDataSource::Add(web_ui->GetWebContents()->GetBrowserContext(),
+                                source);
+
+  auto* handler = new KochNewTabPageHandler(web_ui);
+  web_ui->RegisterMessageCallback(
+      "initialized",
+      base::BindRepeating(&KochNewTabPageHandler::HandleInitialized,
+                          base::Unretained(handler)));
+  web_ui->RegisterMessageCallback(
+      "getSettings",
+      base::BindRepeating(&KochNewTabPageHandler::HandleGetSettings,
+                          base::Unretained(handler)));
+  web_ui->RegisterMessageCallback(
+      "saveSettings",
+      base::BindRepeating(&KochNewTabPageHandler::HandleSaveSettings,
+                          base::Unretained(handler)));
+  web_ui->RegisterMessageCallback(
+      "getBookmarks",
+      base::BindRepeating(&KochNewTabPageHandler::HandleGetBookmarks,
+                          base::Unretained(handler)));
+  web_ui->RegisterMessageCallback(
+      "searchSuggestions",
+      base::BindRepeating(&KochNewTabPageHandler::HandleSearchSuggestions,
+                          base::Unretained(handler)));
+}
+
+KochNewTabPageUI::~KochNewTabPageUI() = default;
+
+WEB_UI_CONTROLLER_FACTORY_IMPL(KochNewTabPageUI, kChromeUIKochNewTabHost)
